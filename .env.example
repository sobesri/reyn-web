# Every VITE_* value is inlined into the public JavaScript bundle.
# Only put things here that are safe for anyone to read.

# Public: this already appears in every image URL.
VITE_CLOUDINARY_CLOUD_NAME=chyv8hgz

# Empty: this account uses dynamic folders, so Media Library folders are
# display-only and are not part of the public id.
VITE_CLOUDINARY_FOLDER=

# Digits only, with country code, e.g. 94771234567
VITE_WHATSAPP_NUMBER=

# Do NOT add the Cloudinary api-key, api-secret or CLOUDINARY_URL.
# This site only reads public images, so it never needs them.

# GA4 measurement id, e.g. G-XXXXXXXXXX. Analytics only loads in a production
# build with this set, so dev sessions never report into the live property.
VITE_GA_MEASUREMENT_ID=
